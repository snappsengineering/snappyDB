# snappy-ci config. After editing: snappy-ci render .
DEFAULT_BRANCH=develop
# COVERAGE_MIN: macOS line-coverage floor, 0 = report only. Only ever raise it
#   (`snappy-ci ratchet .` sets it to the measured value).
# PLATFORMS: extra generic builds (iOS tvOS watchOS); macOS is built by the test job.
# SIM_TESTS: platforms tested on a simulator (iOS tvOS watchOS); removed from PLATFORMS builds.
# SANITIZE: extra macOS sanitizer test jobs (thread address). WARNINGS_AS_ERRORS: swift build gate.
# API_CHECK: API-break gate vs latest tag of this line. MERGE_FORWARD: previous line must be merged in.
# TIMEOUT: minutes per job. PR_REQUIRED / ENFORCE_ADMINS: used by `protect` only.
KIND=package
SCHEME=SnappyDB
TEST_ON=macos
COVERAGE_MIN=100
PLATFORMS=iOS tvOS watchOS
EXAMPLE_PROJECT=Example/SnappyDBDemo.xcodeproj
EXAMPLE_SCHEME=SnappyDBDemo
APP_PROJECT=
APP_SCHEME=
RUNNER=macos-26
HYGIENE=full
API_CHECK=true
SIM_TESTS=iOS tvOS watchOS
SANITIZE=thread
WARNINGS_AS_ERRORS=true
MERGE_FORWARD=false
TIMEOUT=20
PR_REQUIRED=false
ENFORCE_ADMINS=true
DEPENDABOT=false
PUSH_BRANCHES=develop, 'release/**'
IOS_SIMULATOR=iPhone 17
WATCHOS_SIMULATOR=Apple Watch Series 11 (46mm)
LATEST_TAG=false
RELEASE_LINES=16 18 26 27
TVOS_SIMULATOR=Apple TV 4K (3rd generation)
